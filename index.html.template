<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HTML Tools</title>
  <meta name="description" content="A collection of minimalist tools implemented as single HTML files with embedded CSS and Javascript.">
  <style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    background: #f7f4ef;
    color: #334e68;
    display: grid;
    place-items: start center;
    padding: 40px 24px;
  }

  main {
    width: min(600px, 100%);
  }

  h1 {
    margin: 0 0 24px;
    font-size: 1.5rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 10px 0;
    border-bottom: 1px solid #d8e1e8;
  }

  li:first-child {
    border-top: 1px solid #d8e1e8;
  }

  a {
    color: #2680c2;
    font-weight: 500;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .desc {
    margin: 2px 0 0;
    font-size: 0.875rem;
    color: #486581;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.875rem;
    font-weight: normal;
  }

  .github-link svg {
    flex-shrink: 0;
  }
  </style>
</head>
<body>
  <main>
    <h1>HTML Tools</h1>
    <p>
      A collection of minimalist tools implemented as single HTML files with embedded CSS and Javascript.
    </p>
    <p>
      <a class="github-link" href="https://github.com/jayqi/html-tools">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
